@startuml

box "Supplier"
participant Supplier as "PCN Application"
participant SMService as "Submodel Repository Interface"
end box

box "Delivery"
participant Broker as "Message Broker"
end box

box "Customer"
participant Customer as "Procurement Application"
end box

activate Supplier
Supplier -> SMService : PostSubmodelElementByPath(pcnSubmodelId, "Records", record)
activate SMService
SMService -> SMService : commit change and derive changed elements
Supplier <-- SMService : SuccessCreated
deactivate Supplier

SMService -> Broker : io.admin-shell.submodelelement.created.v1\n(subject "Records[4]")
SMService -> Broker : io.admin-shell.pcn.created.v1\n(record in ValueOnly serialization)
SMService -> Broker : io.admin-shell.submodel.updated.v1
deactivate SMService

note over Broker
  The customer subscribed only to
  io.admin-shell.pcn.created.v1
  for the globalAssetIds of its purchased parts.
end note

Broker -> Customer : io.admin-shell.pcn.created.v1
activate Customer
Customer -> Customer : evaluate affected parts and orders
Customer -> Customer : trigger follow-up (e.g. requalification task)
deactivate Customer

@enduml
